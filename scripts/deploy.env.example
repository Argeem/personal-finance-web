# ==============================================================================
# Configuration file for remote deployment via scripts/deploy.sh
# คัดลอกไฟล์นี้เป็น .env.deploy แล้วแก้ไขข้อมูล Server ของคุณ:
#   cp scripts/deploy.env.example scripts/.env.deploy
# ==============================================================================

# IP Address หรือ Domain Name ของ Server (ที่เดียวกับที่รัน argeem-web)
SERVER_HOST="your-server-ip-or-domain.com"

# SSH Username บน Server (เช่น root, ubuntu)
SERVER_USER="root"

# SSH Port (ปกติ 22)
SERVER_PORT="22"

# ปลายทาง Web Root บน Server (ตามที่ตั้งค่าใน scripts/server-setup.sh)
SERVER_PATH="/var/www/personal-financial-web/dist"

# Base URL path สำหรับ Vite build
VITE_BASE_PATH="/personal/finance/"
